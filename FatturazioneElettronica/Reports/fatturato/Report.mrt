        <Alias>fatturato</Alias>
        <Columns isList="true" count="6">
          <value>anno,Anno,System.Int32</value>
          <value>mese,Mese,System.Int32</value>
          <value>n_fatture,Num_fatture,System.Int32</value>
          <value>imponibile,Imponibile,System.Decimal</value>
