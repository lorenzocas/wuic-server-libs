        <Dictionary isRef="1" />
        <Key>e5f6a7b8c9d04a13e8f0a2b3c4d5e6f7</Key>
        <Name>fatturato</Name>
        <NameInSource>Connessione</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT YEAR(data_documento) AS anno, MONTH(data_documento) AS mese, COUNT(*) AS n_fatture, SUM(ISNULL(imponibile,0)) AS imponibile, SUM(ISNULL(iva,0)) AS iva, SUM(ISNULL(totale,0)) AS totale FROM dbo.fatture_inviate WHERE ISNULL(cancellato,0) = 0 AND stato IN ('EMESSA','CONSEGNATA') GROUP BY YEAR(data_documento), MONTH(data_documento) ORDER BY anno DESC, mese DESC</SqlCommand>
      </fatturato>
