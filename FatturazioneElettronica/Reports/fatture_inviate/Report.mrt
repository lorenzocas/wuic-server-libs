      <CommandTimeout>300</CommandTimeout>
      <Dictionary isRef="1" />
      <Key>fa0509a2b2c3d4e5f60718293a4b5c6d</Key>
      <Name>fatture_inviate_righe</Name>
      <NameInSource>Connessione</NameInSource>
      <Parameters isList="true" count="0" />
      <SqlCommand>SELECT r.[id] AS [id], r.[fattura_id] AS [fattura_id], r.[riga] AS [riga], r.[descrizione] AS [descrizione], r.[quantita] AS [quantita], ISNULL(um.[codice], '') AS [um_codice], r.[prezzo_unitario] AS [prezzo_unitario], r.[sconto_perc] AS [sconto_perc], r.[imponibile_riga] AS [imponibile_riga], r.[iva_riga] AS [iva_riga], r.[totale_riga] AS [totale_riga], ISNULL(ci.[aliquota], 0)  AS [aliquota], ISNULL(ci.[natura_sdi], '') AS [natura_sdi] FROM [FatturazioneElettronica_Data].[dbo].[fatture_inviate_righe] r LEFT JOIN [FatturazioneElettronica_Data].[dbo].[unita_misura] um ON r.unita_misura_id = um.id LEFT JOIN [FatturazioneElettronica_Data].[dbo].[codici_iva]  ci ON r.codice_iva_id   = ci.id WHERE r.fattura_id = @fattura_id ORDER BY r.riga ASC</SqlCommand>
    </fatture_inviate_righe>
    <scadenze Ref="5" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
