        <Name>fatture_inviate</Name>
        <NameInSource>Connessione</NameInSource>
        <Parameters isList="true" count="1">
          <fattura_id Ref="30" type="Stimulsoft.Report.Dictionary.StiDataParameter" isKey="true">
            <Name>fattura_id</Name>
            <ParameterDirection>Input</ParameterDirection>
            <Size>4</Size>
            <Type>Int32</Type>
            <Value>0</Value>
          </fattura_id>
        </Parameters>
        <SqlCommand>SELECT f.id, f.numero, f.data_documento, c.ragione_sociale AS cliente_ragione_sociale, c.partita_iva AS cliente_partita_iva, c.indirizzo AS cliente_indirizzo, (ISNULL(c.cap,'') + ' ' + ISNULL(c.citta,'') + ' (' + ISNULL(c.provincia,'') + ')') AS cliente_cap_citta, f.imponibile, f.iva, f.totale, f.causale FROM dbo.fatture_inviate f JOIN dbo.clienti c ON c.id = f.cliente_id WHERE f.id = @fattura_id</SqlCommand>
      </fatture_inviate>
      <righe Ref="4" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
