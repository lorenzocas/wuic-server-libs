      <Dictionary isRef="1" />
      <Key>fa0509a3b2c3d4e5f60718293a4b5c6d</Key>
      <Name>scadenze</Name>
      <NameInSource>Connessione</NameInSource>
      <Parameters isList="true" count="0" />
      <SqlCommand>SELECT s.[id] AS [id], s.[fattura_inviata_id] AS [fattura_inviata_id], s.[rata_n] AS [rata_n], s.[rata_totale] AS [rata_totale], s.[data_scadenza] AS [data_scadenza], s.[importo] AS [importo], s.[stato] AS [stato], ISNULL(pg.[descrizione], '') AS [pagamento_descrizione], ISNULL(b.[descrizione], '')  AS [banca_descrizione], ISNULL(b.[iban], '')         AS [banca_iban], ISNULL(b.[bic_swift], '')    AS [banca_bic] FROM [FatturazioneElettronica_Data].[dbo].[scadenze] s LEFT JOIN [FatturazioneElettronica_Data].[dbo].[pagamenti] pg ON s.pagamento_id = pg.id LEFT JOIN [FatturazioneElettronica_Data].[dbo].[banche] b    ON s.banca_id     = b.id WHERE COALESCE(s.cancellato, 0) = 0 AND s.fattura_inviata_id = @fattura_id ORDER BY s.rata_n ASC</SqlCommand>
    </scadenze>
