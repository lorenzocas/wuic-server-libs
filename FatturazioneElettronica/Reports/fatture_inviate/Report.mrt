          <value>imponibile_riga,Imponibile_riga,System.Decimal</value>
        </Columns>
        <CommandTimeout>300</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>d0e1f2a3b4c5436de8f0a2b3c4d5e6f7</Key>
        <Name>righe</Name>
        <NameInSource>Connessione</NameInSource>
        <Parameters isList="true" count="1">
          <fattura_id Ref="31" type="Stimulsoft.Report.Dictionary.StiDataParameter" isKey="true">
            <Name>fattura_id</Name>
            <ParameterDirection>Input</ParameterDirection>
            <Size>4</Size>
            <Type>Int32</Type>
            <Value>0</Value>
          </fattura_id>
        </Parameters>
        <SqlCommand>SELECT r.riga, r.descrizione, r.quantita, r.prezzo_unitario, ci.aliquota AS aliquota_iva, r.imponibile_riga FROM dbo.fatture_inviate_righe r LEFT JOIN dbo.codici_iva ci ON ci.id = r.codice_iva_id WHERE r.fattura_id = @fattura_id ORDER BY r.riga</SqlCommand>
      </righe>
