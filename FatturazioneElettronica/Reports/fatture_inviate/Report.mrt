      <Name>fatture_inviate</Name>
      <NameInSource>Connessione</NameInSource>
      <Parameters isList="true" count="0" />
      <SqlCommand>SELECT [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[id] AS [id], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[numero] AS [numero], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[serie] AS [serie], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[progressivo] AS [progressivo], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[anno] AS [anno], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[data_documento] AS [data_documento], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[cliente_id] AS [cliente_id], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[pagamento_id] AS [pagamento_id], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[banca_id] AS [banca_id], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[causale_id] AS [causale_id], [cliente_id_clienti].[ragione_sociale] AS [clienti___ragione_sociale__cliente_id], ISNULL([cliente_id_clienti].[partita_iva],'') AS [cli_piva], ISNULL([cliente_id_clienti].[codice_fiscale],'') AS [cli_cf], ISNULL([cliente_id_clienti].[indirizzo],'') AS [cli_indirizzo], ISNULL([cliente_id_clienti].[cap],'') AS [cli_cap], ISNULL([cliente_id_clienti].[citta],'') AS [cli_citta], ISNULL([cliente_id_clienti].[provincia],'') AS [cli_prov], ISNULL([cliente_id_clienti].[nazione],'IT') AS [cli_naz], ISNULL([cliente_id_clienti].[codice_destinatario],'') AS [cli_cd], ISNULL([cliente_id_clienti].[email],'') AS [cli_email], ISNULL([cliente_id_clienti].[pec],'') AS [cli_pec], [pagamento_id_pagamenti].[descrizione] AS [pagamenti___descrizione__pagamento_id], ISNULL([pagamento_id_pagamenti].[codice_sdi], '') AS [pagamenti___codice_sdi__pagamento_id], [banca_id_banche].[descrizione] AS [banche___descrizione__banca_id], ISNULL([banca_id_banche].[iban], '') AS [banche___iban__banca_id], ISNULL([banca_id_banche].[bic_swift], '') AS [banche___bic_swift__banca_id], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[causale] AS [causale], [causale_id_causali].[descrizione] AS [causali___descrizione__causale_id], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[bollo_valore] AS [bollo_valore], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[imponibile] AS [imponibile], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[iva] AS [iva], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[totale] AS [totale], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[stato] AS [stato], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[stato_sdi] AS [stato_sdi], [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[data_creazione] AS [data_invio] FROM [FatturazioneElettronica_Data].[dbo].[fatture_inviate] LEFT JOIN [FatturazioneElettronica_Data].[dbo].[clienti] AS [cliente_id_clienti] ON [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[cliente_id] = [cliente_id_clienti].[id] LEFT JOIN [FatturazioneElettronica_Data].[dbo].[pagamenti] AS [pagamento_id_pagamenti] ON [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[pagamento_id] = [pagamento_id_pagamenti].[id] LEFT JOIN [FatturazioneElettronica_Data].[dbo].[banche] AS [banca_id_banche] ON [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[banca_id] = [banca_id_banche].[id] LEFT JOIN [FatturazioneElettronica_Data].[dbo].[causali] AS [causale_id_causali] ON [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[causale_id] = [causale_id_causali].[id] WHERE COALESCE([FatturazioneElettronica_Data].[dbo].[fatture_inviate].[cancellato], 0) = 0 AND [FatturazioneElettronica_Data].[dbo].[fatture_inviate].[id] = @fattura_id</SqlCommand>
    </fatture_inviate>
    <fatture_inviate_righe Ref="4" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
