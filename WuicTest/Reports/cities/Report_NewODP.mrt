        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 1 AS "__autogenerated", APPLICATION__CITIES.CITYID AS "CityID", APPLICATION__CITIES.VALIDFROM AS "ValidFrom", APPLICATION__CITIES.CITYNAME AS "CityName", APPLICATION__CITIES.VALIDTO AS "ValidTo",  "LastEditedBy_people".FULLNAME AS "people___FullName__LastEditedBy", APPLICATION__CITIES.LASTEDITEDBY AS "LastEditedBy", APPLICATION__CITIES.LATESTRECORDEDPOPULATION AS "LatestRecordedPopulation",  WUIC_WKB_TO_POINTJSON(APPLICATION__CITIES.LOCATION)  AS "Location",  "StateProvinceID_stateprovinces".STATEPROVINCENAME AS "stateprovinces___StateProvinceName__StateProvinceID", APPLICATION__CITIES.STATEPROVINCEID AS "StateProvinceID",  ''  AS "asas" FROM APPLICATION__CITIES   LEFT JOIN APPLICATION__PEOPLE "LastEditedBy_people" ON APPLICATION__CITIES.LASTEDITEDBY = "LastEditedBy_people".PERSONID  LEFT JOIN APPLICATION__STATEPROVINCES "StateProvinceID_stateprovinces" ON APPLICATION__CITIES.STATEPROVINCEID = "StateProvinceID_stateprovinces".STATEPROVINCEID     ORDER BY APPLICATION__CITIES.CITYID ASC </SqlCommand>
      </cities>
