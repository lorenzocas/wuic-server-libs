<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WuicRagEngine</AssemblyName>
    <RootNamespace>WuicRagEngine</RootNamespace>
    <!-- Satellite caricato via Assembly.LoadFrom da KonvergenceCore solo a flag=true.
         Genera il .deps.json per risolvere i native ONNX a runtime. -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bridge MCP per la modalita' agent-sdk (subscription MAX via `claude` CLI).
         Embeddato nella DLL: il satellite lo estrae in una temp dir per-call, cosi' il
         deploy resta "solo DLL" (nessun file .mjs da stageare separatamente). -->
    <EmbeddedResource Include="agent-sdk\mcp-wuic-tools.mjs">
      <LogicalName>WuicRagEngine.mcp-wuic-tools.mjs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- .Gpu: include sia il provider CUDA (GPU) sia il fallback CPU. Su macchine
         senza CUDA/cuDNN l'append del provider CUDA fallisce e l'engine ricade su CPU
         (vedi OnnxSession.Build). Richiede CUDA 12.x + cuDNN 9.x sul deploy per la GPU. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.26.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

</Project>
