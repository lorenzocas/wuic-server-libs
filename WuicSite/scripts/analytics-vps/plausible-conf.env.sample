# Plausible CE — template di configurazione.
# I placeholder __BASE_URL__ / __SECRET_KEY_BASE__ / __TOTP_VAULT_KEY__ vengono
# sostituiti da wsl-bootstrap.sh alla prima installazione e scritti in
# plausible-conf.env (che NON e' versionato: contiene i segreti).

BASE_URL=__BASE_URL__
SECRET_KEY_BASE=__SECRET_KEY_BASE__
TOTP_VAULT_KEY=__TOTP_VAULT_KEY__

# Connessioni ai db interni del compose (hostname = nome servizio).
DATABASE_URL=postgres://postgres:postgres@plausible_db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

# Registrazione: aperta SOLO per creare il primo utente admin, poi va messa
# a false e i container riavviati (docker compose up -d) — altrimenti chiunque
# raggiunga il dominio puo' creare un account.
DISABLE_REGISTRATION=false

# Niente invio email in uscita per ora (reset password via console se serve).
# Configurabile in seguito con SMTP_* se vuoi i report via email.
MAILER_ADAPTER=Bamboo.LocalAdapter
